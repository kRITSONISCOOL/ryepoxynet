<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Reservation Confirmed – Ryepoxy</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --purple: #8b5cf6;
      --pink: #ec4899;
      --navy: #0f172a;
      --navy2: #1e1b4b;
      --border: rgba(139,92,246,.25);
      --text: #f8fafc;
      --muted: #94a3b8;
      --font: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    }

    body {
      font-family: var(--font);
      background: linear-gradient(160deg, var(--navy) 0%, var(--navy2) 60%, var(--navy) 100%);
      color: var(--text);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    .nav {
      padding: 1.25rem 2rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 1px solid var(--border);
      backdrop-filter: blur(10px);
      background: rgba(15,23,42,.7);
      position: relative;
      z-index: 1;
    }

    .nav-logo {
      font-size: 1.5rem;
      font-weight: 800;
      letter-spacing: -.02em;
      background: linear-gradient(135deg, #c084fc, #f472b6);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      text-decoration: none;
    }

    .main {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 3rem 1.5rem;
      position: relative;
      z-index: 1;
    }

    .card {
      text-align: center;
      max-width: 460px;
      width: 100%;
    }

    .check-circle {
      width: 80px;
      height: 80px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--purple), var(--pink));
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 2rem;
      box-shadow: 0 0 40px rgba(139,92,246,.5), 0 0 80px rgba(236,72,153,.2);
      animation: popIn .5s cubic-bezier(0.34,1.56,0.64,1) both;
    }

    @keyframes popIn {
      from { transform: scale(0); opacity: 0; }
      to   { transform: scale(1); opacity: 1; }
    }

    .check-circle svg { width: 36px; height: 36px; color: #fff; }

    h1 {
      font-size: clamp(1.6rem, 5vw, 2.25rem);
      font-weight: 800;
      background: linear-gradient(135deg, #e2d9f3, #f9a8d4, #c084fc);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      margin-bottom: .75rem;
    }

    .subtitle {
      color: var(--muted);
      font-size: 1rem;
      line-height: 1.65;
      margin-bottom: 2.5rem;
    }

    .info-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
      margin-bottom: 2.5rem;
    }

    .info-item {
      background: rgba(30,27,75,.7);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 1.25rem 1rem;
    }

    .info-item .info-icon {
      width: 32px;
      height: 32px;
      border-radius: 8px;
      background: linear-gradient(135deg, rgba(139,92,246,.2), rgba(236,72,153,.15));
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto .65rem;
    }

    .info-item .info-icon svg { width: 16px; height: 16px; color: #a78bfa; }
    .info-item .info-label { font-size: .75rem; color: var(--muted); font-weight: 600; text-transform: uppercase; letter-spacing: .04em; margin-bottom: .25rem; }
    .info-item .info-value { font-size: .88rem; color: var(--text); font-weight: 500; }

    .btn-home {
      display: inline-flex;
      align-items: center;
      gap: .5rem;
      padding: .85rem 2rem;
      border-radius: 14px;
      background: linear-gradient(135deg, var(--purple), var(--pink));
      color: #fff;
      text-decoration: none;
      font-weight: 700;
      font-size: .95rem;
      transition: opacity .2s, transform .15s;
      box-shadow: 0 4px 20px rgba(139,92,246,.35);
    }

    .btn-home:hover { opacity: .9; transform: translateY(-1px); }
    .btn-home svg { width: 16px; height: 16px; }

    body::before {
      content: '';
      position: fixed;
      top: -20%;
      left: -10%;
      width: 600px;
      height: 600px;
      background: radial-gradient(ellipse, rgba(139,92,246,.15), transparent 65%);
      pointer-events: none;
    }

    body::after {
      content: '';
      position: fixed;
      bottom: -20%;
      right: -10%;
      width: 500px;
      height: 500px;
      background: radial-gradient(ellipse, rgba(236,72,153,.12), transparent 65%);
      pointer-events: none;
    }

    @media (max-width: 400px) {
      .info-grid { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>

  <nav class="nav">
    <a href="/" class="nav-logo">Ryepoxy</a>
  </nav>

  <main class="main">
    <div class="card">
      <div class="check-circle">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
      </div>

      <h1>You're on the list!</h1>
      <p class="subtitle">
        Your reservation is in. No payment has been taken —<br />
        we'll reach out soon to confirm everything and arrange pickup or delivery.
      </p>

      <!-- Order summary (populated from sessionStorage) -->
      <div id="order-summary" style="display:none;background:linear-gradient(145deg,rgba(30,27,75,.9),rgba(49,46,129,.5));border:1px solid rgba(139,92,246,.25);border-radius:16px;padding:1.5rem 1.75rem;margin-bottom:2rem;text-align:left;">
        <div style="font-size:.75rem;font-weight:700;color:#a78bfa;text-transform:uppercase;letter-spacing:.08em;margin-bottom:1rem;">Your Preorder Summary</div>
        <div style="display:grid;gap:.65rem;">
          <div id="summary-product" style="display:none;"><span style="font-size:.8rem;color:#94a3b8;">Product:</span> <span id="summary-product-val" style="font-weight:600;color:#f8fafc;"></span></div>
          <div id="summary-name" style="display:none;"><span style="font-size:.8rem;color:#94a3b8;">Name:</span> <span id="summary-name-val" style="font-weight:600;color:#f8fafc;"></span></div>
          <div id="summary-email" style="display:none;"><span style="font-size:.8rem;color:#94a3b8;">Email:</span> <span id="summary-email-val" style="font-weight:600;color:#f8fafc;"></span></div>
          <div id="summary-phone" style="display:none;"><span style="font-size:.8rem;color:#94a3b8;">Phone:</span> <span id="summary-phone-val" style="font-weight:600;color:#f8fafc;"></span></div>
          <div id="summary-notes" style="display:none;"><span style="font-size:.8rem;color:#94a3b8;">Notes:</span> <span id="summary-notes-val" style="font-weight:600;color:#f8fafc;"></span></div>
        </div>
      </div>

      <div class="info-grid">
        <div class="info-item">
          <div class="info-icon">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.91 12 19.79 19.79 0 0 1 1.88 3.4 2 2 0 0 1 3.86 1.21h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 8.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"></path>
            </svg>
          </div>
          <div class="info-label">Next step</div>
          <div class="info-value">We'll contact you within 1–2 days</div>
        </div>
        <div class="info-item">
          <div class="info-icon">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="1" y="3" width="15" height="13"></rect>
              <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
              <circle cx="5.5" cy="18.5" r="2.5"></circle>
              <circle cx="18.5" cy="18.5" r="2.5"></circle>
            </svg>
          </div>
          <div class="info-label">Price</div>
          <div class="info-value">$5.50 per piece, paid at pickup</div>
        </div>
      </div>

      <a href="/" class="btn-home">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
        Back to Ryepoxy
      </a>
    </div>
  </main>

  <script>
    (function () {
      try {
        var data = sessionStorage.getItem('ryepoxyPreorder');
        if (!data) return;
        var order = JSON.parse(data);
        var summary = document.getElementById('order-summary');
        if (!summary) return;
        var fields = [
          { key: 'product', id: 'summary-product', valId: 'summary-product-val' },
          { key: 'name',    id: 'summary-name',    valId: 'summary-name-val'    },
          { key: 'email',   id: 'summary-email',   valId: 'summary-email-val'   },
          { key: 'phone',   id: 'summary-phone',   valId: 'summary-phone-val'   },
          { key: 'notes',   id: 'summary-notes',   valId: 'summary-notes-val'   },
        ];
        var hasAny = false;
        fields.forEach(function (f) {
          if (order[f.key]) {
            var row = document.getElementById(f.id);
            var val = document.getElementById(f.valId);
            if (row && val) { val.textContent = order[f.key]; row.style.display = 'block'; hasAny = true; }
          }
        });
        if (hasAny) summary.style.display = 'block';
        sessionStorage.removeItem('ryepoxyPreorder');
      } catch (e) {}
    })();
  </script>
</body>
</html>
